# =============================================================================
# ローカルで npm run dev（プレビュー）するとき
# =============================================================================
# API はデフォルトで本番 AWS（config の DIRECT_API_URL）に接続されます。
# .env に古く VITE_API_URL=http://localhost:8000 だけ書いてあるとローカル API に繋がっていたため、
# ローカルバックエンドを使う場合は次の 2 行を有効にしてください。
#
# VITE_LOCAL_API=true
# VITE_API_URL=http://localhost:8000

# =============================================================================
# 本番ビルド（Netlify 等）
# =============================================================================
# ダッシュボードの環境変数で設定推奨（リポジトリに本番 URL をコミットしない）
# VITE_API_URL=https://ddxdewgmen.ap-northeast-1.awsapprunner.com

# =============================================================================
# 新サービス (Supabase / hana-hana) — /app 配下で使用
# =============================================================================
# anon key は Dashboard → Settings → API から取得（公開キーですが .env には含めず環境変数で設定推奨）
# VITE_SUPABASE_URL=https://pwugckmasgrinazktrme.supabase.co
# VITE_SUPABASE_ANON_KEY=
# 表示するサービス名（未設定時は仮称 Hana-Hana）
# VITE_APP_NAME=Hana-Hana
